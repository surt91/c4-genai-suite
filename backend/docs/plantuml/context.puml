@startuml
class ChatContext {
    abort: AbortController
    input: string
    tools: NamedStructuredTool[]
    llms: Record<string, LanguageModelContext>
    llm?: string
    systemMessages: string[]
    history?: MessagesHistory
    result: Subject<StreamEvent>
    cache: ChatCache
    ui: ChatUI
    user: User
    configuration: ConfigurationModel
}

class "Subject<StreamEvent>" as Subject {
    next(event: StreamEvent)
    error(error: Error)
}

abstract class NamedStructuredTool<T> {
    name: string
    displayName: string
    description: string
    schema: ZodObject | Schema
    execute(input: T)
}

class LanguageModelContext {
    model: LanguageModel
    options: CallSettings
    modelName: string
    providerName: string
}

abstract class MessagesHistory {
    getMessages(): BaseMessage[]
    addMessage(message: BaseMessage)
    addSources(externalExtensionId: string, sources: Source[])
}

interface ChatCache {
    get(key, args, resolver, ttl?)
}

interface ChatUI {
    form(text: string, schema: ExtensionArgument): ChatUICallbackResult
}

class CallbackService {
    form(owner, timeout?): CallbackResult<ChatUICallbackResult>
    answer(id: string, owner, result: ChatUICallbackResult): boolean
}

class ConversationsController {
    postMessage(id: number, body)
    confirm(id: number, requestId: string, result)
}

class SendMessageHandler {
    execute(query: SendMessage)
}

interface ChatMiddleware {
    invoke(context: ChatContext, getContext, next)
}

class ExecuteMiddleware {
    invoke(context: ChatContext)
}

package "AI SDK (ai)" {
    class streamText
    class generateText
}

Subject "1" - "1" ChatContext : result
NamedStructuredTool "0..*" -- "1" ChatContext : tools
LanguageModelContext "1..*" --- "1" ChatContext : llms
MessagesHistory "1" -- "1" ChatContext : history
ChatCache "1" -- "1" ChatContext : cache
ChatUI "1" -- "1" ChatContext : ui
ChatUI <|.. ChatUIImpl
ChatUIImpl --> CallbackService : uses
ConversationsController --> CallbackService : answers
ConversationsController --> SendMessageHandler : executes
SendMessageHandler ----> ChatContext : creates
ChatMiddleware --> ChatContext : manipulates
ChatMiddleware <|.. ExecuteMiddleware
ExecuteMiddleware ---> ChatContext : uses
ExecuteMiddleware ---> streamText : calls
ExecuteMiddleware ---> generateText : calls (streaming disabled)
streamText ---> LanguageModelContext : uses model
streamText ---> NamedStructuredTool : calls

MessagesHistory <|-- InternalChatHistory
@enduml

BASE_URL="http://localhost:5173"
AUTH_LOGOUT_REDIRECT="/"
## If you want to test with a local identity provider:
#AUTH_BASEURL=http://localhost:5173/api-proxy/api
#AUTH_OAUTH_AUTHORIZATION_URL=http://localhost:8080/realms/test-realm/protocol/openid-connect/auth
#AUTH_OAUTH_TOKEN_URL=http://localhost:8080/realms/test-realm/protocol/openid-connect/token
#AUTH_OAUTH_USER_INFO_URL=http://localhost:8080/realms/test-realm/protocol/openid-connect/userinfo
#AUTH_OAUTH_CLIENTID=test-client
#AUTH_OAUTH_CLIENTSECRET=secret
## These are example values for a Keycloak with a client `test-client`. Refer to the Keycloak docs for details.
## Microsoft login (Entra ID): the tenant must be the ID of your tenant (`common`, `organizations` and `consumers` are rejected)
#AUTH_MICROSOFT_CLIENTID=
#AUTH_MICROSOFT_CLIENTSECRET=
#AUTH_MICROSOFT_TENANT=00000000-0000-0000-0000-000000000000

AUTH_INITIAL_ADMIN_USERNAME=admin@example.com
AUTH_INITIAL_ADMIN_PASSWORD=secret
AUTH_ENABLE_PASSWORD=true
DB_URL="postgres://admin:secret@localhost:5432/gaible"
## Logging
## - log the requests to the model providers (credentials are redacted)
#DEBUG_MODEL_REQUESTS=true
## - Needed for the openapi generator, due to restrictions in search.maven.org
OPENAPI_GENERATOR_CLI_SEARCH_URL=DEFAULT

## Metrics
METRICS_PORT=0

# (optional) langfuse credentials to enable tracing
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASEURL=

# LLM Eval Service
# Set to 'true' to enable the evaluation service feature in the UI and backend proxy.
# When 'false' (default), the evaluations section is hidden from the admin panel.
EVAL_SERVICE_ENABLED=false
# Internal URL of the eval service (only used when EVAL_SERVICE_ENABLED=true)
EVAL_SERVICE_URL=http://localhost:3202
# Eval service account API key (raw value, hashed and stored in DB at startup)
# Must match eval service's GAIBLE_BACKEND_API_KEY (generate with: openssl rand -hex 32)
EVAL_SERVICE_ACCOUNT_API_KEY=
# Optional: email for the eval service account (default: eval-service@internal)
# EVAL_SERVICE_ACCOUNT_EMAIL=eval-service@internal

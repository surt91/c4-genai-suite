{
  "name": "gaible",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "generate-openapi-dev": "npm run build && node dist/openapi.js -- localFile && node dev/split-openapi.mjs backend-dev-spec.json backend-external-spec.json && npx prettier --write backend-*-spec.json",
    "generate-base": "npx @openapitools/openapi-generator-cli generate -g typescript-fetch --additional-properties=useSingleRequestParameter=false,ensureUniqueParams=false,importFileExtension=.js",
    "generate-reis": "node -e \"fs.rmSync('./src/domain/files/use-cases/generated', { recursive: true, force: true })\" && npm run generate-base -- -i ../services/reis/reis-dev-spec.json -o ./src/domain/files/use-cases/generated",
    "typeorm": "typeorm",
    "migration:run": "npm run build && npm run typeorm -- -d dist/config/typeorm-migration.config.js migration:run",
    "migration:format": "prettier --write src/migrations/*.ts",
    "migration:generate": "npm run build && npm run typeorm -- -d dist/config/typeorm-migration.config.js migration:generate src/migrations/$npm_config_name $npm_config_options",
    "postmigration:generate": "npm run migration:format",
    "migration:generate:dryrun": "npm run build && npm run typeorm -- -d dist/config/typeorm-migration.config.js migration:generate test --dr",
    "migration:create": "npm run typeorm -- migration:create src/migrations/$npm_config_name",
    "postmigration:create": "npm run migration:format",
    "migration:revert": "npm run build && npm run typeorm -- -d dist/config/typeorm-migration.config.js migration:revert"
  },

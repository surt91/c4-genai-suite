{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "build": "tsc && vite build",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.ts\" --",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "find-unused-resources": "knip",
    "preview": "vite preview",
    "generate-api": "node -e \"fs.rmSync('./src/api/generated', { recursive: true, force: true })\" && npx @openapitools/openapi-generator-cli generate && node gen-helper.mjs",
    "copy:pdfjs-wasm": "node copy-pdfjs-wasm.mjs",
    "predev": "npm run copy:pdfjs-wasm",
    "prestart": "npm run copy:pdfjs-wasm",
    "prebuild": "npm run copy:pdfjs-wasm",
    "generate-eval-api": "node -e \"fs.rmSync('./src/api/generated-eval', { recursive: true, force: true })\" && npx @openapitools/openapi-generator-cli generate --generator-key eval && node gen-helper.mjs"
  },
  "dependencies": {
    "@mantine/colors-generator": "9.7.3",
    "@mantine/core": "9.7.3",
    "@mantine/dates": "^9.7.3",
    "@mantine/form": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@mantine/notifications": "9.7.3",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "highlight.js": "^11.12.0",
    "i18next": "^26.5.7",
    "jsondiffpatch": "^0.7.6",
    "katex": "^0.19.0",
    "mantine-form-zod-resolver": "^1.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-i18next": "^17.1.4",
    "react-markdown": "^10.1.0",
    "react-pdf": "^11.0.0",
    "react-resizable-panels": "^4.14.8",
    "react-router-dom": "^7.18.4",
    "react-speech-recognition": "^4.0.1",
    "react-textarea-autosize": "^8.5.9",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@faker-js/faker": "10.6.0",
    "@openapitools/openapi-generator-cli": "2.42.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-speech-recognition": "^3.9.6",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "knip": "6.42.1",
    "msw": "^3.0.3",
    "postcss": "8.5.31",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "katex": "$katex",
    "postcss-selector-parser": "^7.1.7",
    "lodash": "^4.18.1",
    "@ai-sdk/provider-utils": "^4.0.62",
    "basic-ftp": "^6.2.3"
  }
}
